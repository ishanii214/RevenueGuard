# RevenueGuard — example environment variables
#
# Copy this file to .env and fill in real values when a phase needs them.
# All variables below are for future phases — nothing uses them yet.

# --- LLM evidence narration (Phase 4, optional; provider-neutral) ---
# Any OpenAI-compatible /chat/completions endpoint. Local-first: e.g. Ollama
# (https://ollama.com) with an open-weight instruct model, LM Studio, or
# llama.cpp server. Leave LLM_BASE_URL/LLM_MODEL unset to run fully
# deterministically without any LLM.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b-instruct
# LLM_API_KEY=            # optional; only needed by providers that require one
# LLM_TIMEOUT_S=30

# --- LangSmith: agent tracing and evaluation (later phase) ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=revenueguard
