# RevenueGuard dashboard — frontend environment
#
# Copy to .env.local and adjust per environment. Nothing here is hardcoded
# in source; sensible local defaults exist.

# Base URL the API client calls. Unset = "/api" (the Vite dev proxy).
# VITE_API_BASE_URL=http://localhost:8000

# Upstream the Vite dev proxy forwards /api requests to.
# VITE_PROXY_TARGET=http://localhost:8000
